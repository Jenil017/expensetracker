# Copy this file to ".env.local" for local dev (it's gitignored).
# On Render, set these same values in the dashboard (Environment) instead.

# Neon Postgres connection string.
# Neon dashboard -> Connect -> copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Password to unlock the app (you choose this). Must match on Render.
APP_PASSWORD=change-me

# Local API server port (Render provides PORT automatically in production).
PORT=3000
