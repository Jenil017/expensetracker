# Copy this file to ".env.local" for local dev (it's gitignored).
# On Render, set these same values in the dashboard Environment tab.

# Neon Postgres connection string (from the Neon dashboard → Connect).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JWT secret — use a long random string (min 32 chars). NEVER commit the real value.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-secure-random-64-char-string

# Google OAuth Client ID (from Google Console → Credentials → Web application).
# Required for "Continue with Google". Leave empty to disable Google sign-in.
# Authorized JavaScript origins: http://localhost:5173, https://your-app.onrender.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Local API server port (Render provides PORT automatically in production).
PORT=3000
