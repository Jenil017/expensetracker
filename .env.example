# Copy this file to ".env.local" and fill in values from your Firebase project.
# Firebase Console -> Project settings -> "Your apps" -> Web app -> SDK setup & config.
# These VITE_FIREBASE_* values are NOT secret (access is controlled by Firestore rules + login).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only this Google account may sign in. Must match the email in firestore.rules.
VITE_OWNER_EMAIL=moradiyajenil528@gmail.com
