rules_version = '2';

// Only the owner's Google account can read or write any data.
// IMPORTANT: keep this email in sync with VITE_OWNER_EMAIL in your .env.local / Vercel env.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.token.email == 'yagnik.laughlogiclabs@gmail.com';
    }

    match /ledgers/{id} {
      allow read, write: if isOwner();
    }
    match /transactions/{id} {
      allow read, write: if isOwner();
    }

    // Everything else is denied by default.
  }
}
